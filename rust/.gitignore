# Ignore everything in target/ by default …
/target/*

# … but keep the per-target output dirs that ship the release prebuilt .a.
!/target/aarch64-apple-ios
!/target/aarch64-apple-ios-sim
!/target/x86_64-apple-ios
!/target/aarch64-linux-android
!/target/armv7-linux-androideabi
!/target/i686-linux-android
!/target/x86_64-linux-android

# Within each kept target dir, ignore everything except the release .a.
/target/*/*
!/target/*/release
/target/*/release/*
!/target/*/release/libopaque_rust.a
